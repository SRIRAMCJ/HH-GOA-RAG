APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=7860
FRONTEND_ORIGIN=*

# HH Goa required STT provider
STT_PROVIDER=sarvam
SARVAM_API_KEY=

# Hosted Hugging Face generation
HF_TOKEN=
HF_LLM_MODEL=Qwen/Qwen3-30B-A3B
HF_INFERENCE_PROVIDER=auto

# Hosted embedding/reranking model
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_RERANKER_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Dataset/index
HF_DATASET_ID=ai4bharat/MSMARCO-XI
INDEX_DIR=artifacts/index
INDEX_MAX_DOCS=5000

# Retrieval
DENSE_TOP_K=20
LEXICAL_TOP_K=20
RERANK_TOP_K=5

# Guardrails
MIN_RETRIEVAL_SCORE=0
MAX_CONTEXT_CHARS=12000

# Benchmark
BENCHMARK_QUERIES=100
