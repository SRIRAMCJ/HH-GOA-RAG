APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Required HH Goa STT provider: elevenlabs or sarvam
STT_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
SARVAM_API_KEY=

# Hosted Hugging Face generation
HF_TOKEN=
HF_LLM_MODEL=Qwen/Qwen3-30B-A3B
HF_INFERENCE_PROVIDER=deepinfra

# Retrieval models
HF_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
HF_RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# Dataset
HF_DATASET_ID=ai4bharat/MSMARCO-XI

# Retrieval tuning
DENSE_TOP_K=20
LEXICAL_TOP_K=20
RERANK_TOP_K=5
CHUNK_SIZE=384
CHUNK_OVERLAP=64

# Guardrails
MIN_RETRIEVAL_SCORE=0.20
MAX_CONTEXT_CHARS=12000

# Benchmark
BENCHMARK_QUERIES=100
